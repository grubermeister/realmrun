{
  "name": "realmrun",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "start": "node init && bun run src/main.ts",
    "db:reset": "bun run scripts/reset-dev-db.ts",
    "test": "bun test",
    "typecheck": "tsc --noEmit",
    "viewer:build": "bun build ./viewer/src/main.ts --target browser --format esm --outdir ./viewer/dist",
    "viewer:typecheck": "tsc -p viewer/tsconfig.json --noEmit"
  },
  "dependencies": {
    "dotenv": "^8.2.0",
    "lattice-accumulator-module": "file:./modules/accumulator",
    "lattice-climate-module": "file:./modules/climate",
    "lattice-terrain-module": "file:./modules/terrain",
    "node-fetch": "^3.3.2",
    "pg": "^8.23.1",
    "realmlib": "file:../realmlib"
  },
  "devDependencies": {
    "@types/bun": "1.4.3",
    "@types/pg": "^8.23.1",
    "typescript": "^7.0.2"
  }
}
